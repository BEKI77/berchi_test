# Copy to .env.cashier on the cashier PC and fill in. Never commit .env.cashier.
# Used with:  docker compose -f docker-compose.cashier.yml --env-file .env.cashier up -d --build

# Database password. Only the app container can reach the database, but pick
# something real anyway. Letters and digits only -- it is placed inside a URL.
POSTGRES_PASSWORD=

# Signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later logs everyone out.
AUTH_SECRET=

# The first login. Used only while no owner exists; changing these afterwards
# does nothing, so change the password inside the app. At least 10 characters.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=
SALON_NAME=

# Port the tablets connect to: http://<this PC's address>:APP_PORT
APP_PORT=3000

# Branch code put on order and invoice numbers, e.g. BOLE gives
# BOLE-ORD-20260823-0001. Set it BEFORE a second branch shares a database.
# SALON_SITE_CODE=
