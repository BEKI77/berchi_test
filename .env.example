# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses the Postgres in docker-compose.yml.
#
# Note the port. This machine already runs two native PostgreSQL services on
# 5432 and 5433, so the container binds 5442 by default -- pointing at 5432
# silently connects to the wrong server and fails with
# "password authentication failed for user berchi".
DATABASE_URL=postgres://berchi:berchi_secret@localhost:5442/berchi_salon

# Host port for the docker-compose Postgres. Change if 5442 is taken too.
POSTGRES_PORT=5442

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Shared stylist tablet
# ---------------------------------------------------------------------------
# Lets stylists pick their name and enter a 4-digit PIN instead of an email and
# password (screen: /tablet). Turn it on ONLY for the salon PC. Leave it off for
# anything reachable from the internet: a short PIN is only safe behind the
# salon's own Wi-Fi.
ENABLE_PIN_LOGIN=false
# Minutes with no touch before the tablet signs the stylist out. Default 3.
# PIN_IDLE_MINUTES=3

# ---------------------------------------------------------------------------
# Salon identity
# ---------------------------------------------------------------------------
# Branch code prefixed onto order and invoice numbers, e.g. BOLE gives
# BOLE-ORD-20260823-0001. Leave unset for a single-location salon. Set it
# BEFORE a second branch starts syncing into the same cloud database, or the
# two will mint identical order numbers.
# SALON_SITE_CODE=BOLE
